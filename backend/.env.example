# Copier ce fichier en .env et adapter les valeurs. Ne jamais committer .env.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose expose le port 5433 sur la machine hôte)
DATABASE_URL=postgres://eventpass:eventpass@localhost:5433/eventpass
# Base utilisée par Jest (elle est vidée à chaque lancement des tests)
TEST_DATABASE_URL=postgres://eventpass:eventpass@localhost:5433/eventpass_test

# JWT — secret long et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-caracteres
# Durée de validité du jeton : nombre de secondes ou format "15m", "2h", "7d"
JWT_EXPIRES_IN=2h

# QR codes des billets — secret HMAC DIFFÉRENT de JWT_SECRET (même commande pour le générer)
QR_SECRET=remplacer-par-une-autre-chaine-aleatoire-d-au-moins-32-caracteres
# Le check-in reste possible jusqu'à N heures après le début de l'événement
CHECKIN_WINDOW_HOURS=12

# Coût de bcrypt (10–12 en production ; plus c'est haut, plus le hachage est lent)
BCRYPT_ROUNDS=10

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Limitation des tentatives de connexion : N essais par fenêtre de X minutes et par IP
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
